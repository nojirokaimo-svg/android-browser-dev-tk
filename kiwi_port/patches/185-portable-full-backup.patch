+    private boolean stagePortablePayload(File archive) throws IOException {
+        File pendingPortable = new File(getNoBackupFilesDir(), PENDING_PORTABLE);
+        deleteRecursively(pendingPortable);
+        try (ZipInputStream zip =
+                new ZipInputStream(new BufferedInputStream(new FileInputStream(archive)))) {
+            ZipEntry entry;
+            while ((entry = zip.getNextEntry()) != null) {
+                if (!PORTABLE_SENSITIVE_ENTRY.equals(entry.getName())) {
+                    zip.closeEntry();
+                    continue;
+                }
+                try (OutputStream output =
+                        new BufferedOutputStream(new FileOutputStream(pendingPortable), 1024 * 1024)) {
+                    byte[] buffer = new byte[64 * 1024];
+                    int total = 0;
+                    int count;
+                    while ((count = zip.read(buffer)) != -1) {
+                        total += count;
+                        if (total > MAX_PORTABLE_BYTES) throw new IOException("Portable payload is too large");
+                        output.write(buffer, 0, count);
+                    }
+                }
+                zip.closeEntry();
+                return true;
+            }
+        }
+        return false;
+    }
