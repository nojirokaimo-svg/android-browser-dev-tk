+    private static byte[] serializePortablePayload(
+            PasswordStoreCredential[] credentials, byte[] cookies) throws IOException {
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        try (DataOutputStream out = new DataOutputStream(bytes)) {
+            out.writeInt(PORTABLE_VERSION);
+            out.writeInt(credentials.length);
+            for (PasswordStoreCredential credential : credentials) {
+                writeUtf8(out, credential.getUrl().getSpec());
+                writeUtf8(out, credential.getUsername());
+                writeUtf8(out, credential.getPassword());
+            }
+            out.writeInt(cookies.length);
+            out.write(cookies);
+        }
+        return bytes.toByteArray();
+    }
+
+    private static PortablePayload parsePortablePayload(byte[] bytes) throws IOException {
+        try (DataInputStream in = new DataInputStream(new ByteArrayInputStream(bytes))) {
+            if (in.readInt() != PORTABLE_VERSION) throw new IOException("Unsupported portable format");
+            int count = in.readInt();
+            if (count < 0 || count > 100000) throw new IOException("Invalid credential count");
+            PortableCredential[] credentials = new PortableCredential[count];
+            for (int i = 0; i < count; i++) {
+                credentials[i] = new PortableCredential(readUtf8(in), readUtf8(in), readUtf8(in));
+            }
+            int cookieLength = in.readInt();
+            if (cookieLength < 0 || cookieLength > MAX_PORTABLE_BYTES) {
+                throw new IOException("Invalid cookie payload");
+            }
+            byte[] cookies = new byte[cookieLength];
+            in.readFully(cookies);
+            return new PortablePayload(credentials, cookies);
+        }
+    }
+
+    private static byte[] encryptPortablePayload(byte[] plaintext, char[] passphrase)
+            throws GeneralSecurityException, IOException {
+        SecureRandom random = new SecureRandom();
+        byte[] salt = new byte[16];
+        byte[] iv = new byte[12];
+        random.nextBytes(salt);
+        random.nextBytes(iv);
+        SecretKeySpec key = derivePortableKey(passphrase, salt);
+        Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+        cipher.init(Cipher.ENCRYPT_MODE, key, new GCMParameterSpec(128, iv));
+        byte[] encrypted = cipher.doFinal(plaintext);
+        ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        try (DataOutputStream out = new DataOutputStream(bytes)) {
+            out.writeInt(PORTABLE_MAGIC);
+            out.writeInt(PORTABLE_VERSION);
+            out.writeInt(PBKDF2_ITERATIONS);
+            out.writeInt(salt.length);
+            out.write(salt);
+            out.writeInt(iv.length);
+            out.write(iv);
+            out.writeInt(encrypted.length);
+            out.write(encrypted);
+        }
+        return bytes.toByteArray();
+    }
+
+    private static byte[] decryptPortablePayload(byte[] payload, char[] passphrase)
+            throws GeneralSecurityException, IOException {
+        try (DataInputStream in = new DataInputStream(new ByteArrayInputStream(payload))) {
+            if (in.readInt() != PORTABLE_MAGIC || in.readInt() != PORTABLE_VERSION) {
+                throw new IOException("Unsupported migration backup");
+            }
+            int iterations = in.readInt();
+            if (iterations < 100000 || iterations > 1000000) throw new IOException("Invalid KDF");
+            byte[] salt = readSizedBytes(in, 64);
+            byte[] iv = readSizedBytes(in, 32);
+            byte[] encrypted = readSizedBytes(in, MAX_PORTABLE_BYTES);
+            PBEKeySpec spec = new PBEKeySpec(passphrase, salt, iterations, 256);
+            byte[] keyBytes = SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256").generateSecret(spec).getEncoded();
+            spec.clearPassword();
+            try {
+                Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+                cipher.init(Cipher.DECRYPT_MODE, new SecretKeySpec(keyBytes, "AES"), new GCMParameterSpec(128, iv));
+                return cipher.doFinal(encrypted);
+            } finally {
+                Arrays.fill(keyBytes, (byte) 0);
+            }
+        }
+    }
+
+    private static SecretKeySpec derivePortableKey(char[] passphrase, byte[] salt)
+            throws GeneralSecurityException {
+        PBEKeySpec spec = new PBEKeySpec(passphrase, salt, PBKDF2_ITERATIONS, 256);
+        byte[] keyBytes = SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256").generateSecret(spec).getEncoded();
+        spec.clearPassword();
+        try {
+            return new SecretKeySpec(keyBytes, "AES");
+        } finally {
+            Arrays.fill(keyBytes, (byte) 0);
+        }
+    }
+
+    private static void writeUtf8(DataOutputStream out, String value) throws IOException {
+        byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+        out.writeInt(bytes.length);
+        out.write(bytes);
+    }
+
+    private static String readUtf8(DataInputStream in) throws IOException {
+        byte[] bytes = readSizedBytes(in, 16 * 1024 * 1024);
+        return new String(bytes, StandardCharsets.UTF_8);
+    }
+
+    private static byte[] readSizedBytes(DataInputStream in, int max) throws IOException {
+        int length = in.readInt();
+        if (length < 0 || length > max) throw new IOException("Invalid encrypted payload");
+        byte[] bytes = new byte[length];
+        in.readFully(bytes);
+        return bytes;
+    }
+
+    private static byte[] readFileLimited(File file, int max) throws IOException {
+        if (!file.isFile() || file.length() > max) throw new IOException("Portable payload missing or too large");
+        try (InputStream input = new BufferedInputStream(new FileInputStream(file));
+                ByteArrayOutputStream output = new ByteArrayOutputStream()) {
+            byte[] buffer = new byte[64 * 1024];
+            int total = 0;
+            int count;
+            while ((count = input.read(buffer)) != -1) {
+                total += count;
+                if (total > max) throw new IOException("Portable payload too large");
+                output.write(buffer, 0, count);
+            }
+            return output.toByteArray();
+        }
+    }
