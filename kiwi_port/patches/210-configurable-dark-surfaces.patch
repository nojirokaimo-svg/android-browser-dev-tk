+    private void initDarkSurfaceColorPref() {
+        Preference preference = findPreference("kiwi_dark_surface_color");
+        assert preference != null;
+        boolean ja = Locale.getDefault().getLanguage().equals("ja");
+        preference.setTitle(ja ? "暗色画面の背景色" : "Dark interface surface color");
+        String chosen =
+                requireContext()
+                        .getApplicationContext()
+                        .getSharedPreferences("kiwi_ui_color", Context.MODE_PRIVATE)
+                        .getString("dark_surface_hex", null);
+        preference.setSummary(
+                chosen == null
+                        ? (ja ? "標準（設定・履歴・メニュー）" : "Default (settings, history, menus)")
+                        : chosen);
+        preference.setOnPreferenceClickListener(
+                ignored -> {
+                    String[] options =
+                            ja
+                                    ? new String[] {
+                                        "標準に戻す", "黒 #000000", "濃いグレー #16171B", "グレー #202124"
+                                    }
+                                    : new String[] {
+                                        "Use default", "Black #000000", "Dark gray #16171B", "Gray #202124"
+                                    };
+                    new AlertDialog.Builder(requireContext())
+                            .setTitle(preference.getTitle())
+                            .setItems(
+                                    options,
+                                    (dialog, which) -> {
+                                        @Nullable String chosenColor =
+                                                which == 0
+                                                        ? null
+                                                        : new String[] {"#000000", "#16171B", "#202124"}[
+                                                                which - 1];
+                                        saveDarkSurfaceColor(chosenColor);
+                                    })
+                            .setNeutralButton(
+                                    ja ? "HEXで指定" : "Custom HEX",
+                                    (dialog, which) -> showCustomDarkSurfaceColorDialog(ja))
+                            .setNegativeButton(ja ? "キャンセル" : "Cancel", null)
+                            .show();
+                    return true;
+                });
+    }
+
+    private void saveDarkSurfaceColor(@Nullable String hex) {
+        var editor =
+                requireContext()
+                        .getApplicationContext()
+                        .getSharedPreferences("kiwi_ui_color", Context.MODE_PRIVATE)
+                        .edit();
+        if (hex == null) {
+            editor.remove("dark_surface_hex");
+        } else {
+            editor.putString("dark_surface_hex", hex);
+        }
+        editor.apply();
+        requireActivity().recreate();
+    }
+
+    private void showCustomDarkSurfaceColorDialog(boolean ja) {
+        EditText input = new EditText(requireContext());
+        input.setSingleLine(true);
+        String previous =
+                requireContext()
+                        .getApplicationContext()
+                        .getSharedPreferences("kiwi_ui_color", Context.MODE_PRIVATE)
+                        .getString("dark_surface_hex", "#202124");
+        input.setText(previous);
+        input.selectAll();
+        AlertDialog dialog =
+                new AlertDialog.Builder(requireContext())
+                        .setTitle(ja ? "暗色画面の背景色 (#RRGGBB)" : "Dark surface color (#RRGGBB)")
+                        .setView(input)
+                        .setPositiveButton(ja ? "適用" : "Apply", null)
+                        .setNegativeButton(ja ? "キャンセル" : "Cancel", null)
+                        .create();
+        dialog.setOnShowListener(
+                ignored ->
+                        dialog.getButton(AlertDialog.BUTTON_POSITIVE)
+                                .setOnClickListener(
+                                        button -> {
+                                            String hex =
+                                                    input.getText().toString().trim().toUpperCase(Locale.ROOT);
+                                            if (!hex.matches("#[0-9A-F]{6}")
+                                                    || Color.luminance(Color.parseColor(hex)) > 0.18) {
+                                                input.setError(
+                                                        ja
+                                                                ? "暗い色を #RRGGBB で入力してください"
+                                                                : "Enter a dark #RRGGBB color");
+                                                return;
+                                            }
+                                            saveDarkSurfaceColor(hex);
+                                            dialog.dismiss();
+                                        }));
+        dialog.show();
     }
 
