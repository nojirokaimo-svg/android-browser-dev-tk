 public class SemanticColorUtils {
     private static final String TAG = "SemanticColorUtils";
 
+    /** Optional color for browser-owned dark surfaces; light mode keeps the normal palette. */
+    public static @Nullable Integer getCustomDarkSurfaceColor(Context context) {
+        if (!ColorUtils.inNightMode(context)) return null;
+        String hex =
+                context.getApplicationContext()
+                        .getSharedPreferences("kiwi_ui_color", Context.MODE_PRIVATE)
+                        .getString("dark_surface_hex", null);
+        if (hex == null || !hex.matches("#[0-9a-fA-F]{6}")) return null;
+        int color = Color.parseColor(hex);
+        // White icons and labels must remain legible even after an external preference edit.
+        return Color.luminance(color) <= 0.18 ? color : null;
+    }
