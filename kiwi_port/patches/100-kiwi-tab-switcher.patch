@@ -0,0 +1,132 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.settings;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.util.AttributeSet;
+import android.widget.RadioGroup;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceViewHolder;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.lifetime.ApplicationLifetime;
+import org.chromium.components.browser_ui.widget.RadioButtonWithDescription;
+import org.chromium.components.browser_ui.widget.RadioButtonWithDescriptionLayout;
+
+import java.util.Locale;
+
+/** Kiwi-compatible tab switcher selector. */
+@NullMarked
+public final class RadioButtonGroupTabSwitcherPreference extends Preference
+        implements RadioGroup.OnCheckedChangeListener {
+    public static final String PREF_ACTIVE_TAB_SWITCHER = "active_tabswitcher";
+
+    private @Nullable Activity mActivity;
+    private @Nullable PreferenceViewHolder mHolder;
+
+    public RadioButtonGroupTabSwitcherPreference(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        setLayoutResource(R.layout.radio_button_group_tabswitcher_preference);
+    }
+
+    public void setActivity(Activity activity) {
+        mActivity = activity;
+    }
+
+    @Override
+    public void onBindViewHolder(PreferenceViewHolder holder) {
+        super.onBindViewHolder(holder);
+        mHolder = holder;
+
+        RadioButtonWithDescription choiceDefault = button(holder, R.id.radio_button_default);
+        RadioButtonWithDescription choiceOriginal = button(holder, R.id.radio_button_original);
+        RadioButtonWithDescription choiceHorizontal = button(holder, R.id.radio_button_horizontal);
+        RadioButtonWithDescription choiceClassic = button(holder, R.id.radio_button_classic);
+        RadioButtonWithDescription choiceGrid = button(holder, R.id.radio_button_grid);
+        RadioButtonWithDescription choiceList = button(holder, R.id.radio_button_list);
+        RadioButtonWithDescription choiceDesktop = button(holder, R.id.radio_button_desktop);
+
+        choiceDefault.setPrimaryText("Default");
+        choiceOriginal.setPrimaryText("Original (vertical, same as old Chromium)");
+        choiceHorizontal.setPrimaryText("Horizontal (same as old Chromium)");
+        choiceClassic.setPrimaryText("Vertical (supports tab group)");
+        choiceGrid.setPrimaryText("Grid (supports tab group)");
+        choiceList.setPrimaryText("List");
+        choiceDesktop.setPrimaryText("Desktop (like on a computer)");
+
+        String current =
+                ContextUtils.getAppSharedPreferences()
+                        .getString(PREF_ACTIVE_TAB_SWITCHER, "default");
+        switch (current) {
+            case "original" -> choiceOriginal.setChecked(true);
+            case "horizontal" -> choiceHorizontal.setChecked(true);
+            case "classic" -> choiceClassic.setChecked(true);
+            case "grid" -> choiceGrid.setChecked(true);
+            case "list" -> choiceList.setChecked(true);
+            case "desktop" -> choiceDesktop.setChecked(true);
+            default -> choiceDefault.setChecked(true);
+        }
+
+        RadioButtonWithDescriptionLayout group =
+                (RadioButtonWithDescriptionLayout) holder.findViewById(R.id.radio_button_group);
+        group.setOnCheckedChangeListener(this);
+    }
+
+    @Override
+    public void onCheckedChanged(RadioGroup group, int checkedId) {
+        PreferenceViewHolder holder = mHolder;
+        if (holder == null) return;
+
+        String selected;
+        if (button(holder, R.id.radio_button_original).isChecked()) {
+            selected = "original";
+        } else if (button(holder, R.id.radio_button_horizontal).isChecked()) {
+            selected = "horizontal";
+        } else if (button(holder, R.id.radio_button_classic).isChecked()) {
+            selected = "classic";
+        } else if (button(holder, R.id.radio_button_grid).isChecked()) {
+            selected = "grid";
+        } else if (button(holder, R.id.radio_button_list).isChecked()) {
+            selected = "list";
+        } else if (button(holder, R.id.radio_button_desktop).isChecked()) {
+            selected = "desktop";
+        } else {
+            selected = "default";
+        }
+
+        SharedPreferences prefs = ContextUtils.getAppSharedPreferences();
+        if (selected.equals(prefs.getString(PREF_ACTIVE_TAB_SWITCHER, "default"))) return;
+        prefs.edit().putString(PREF_ACTIVE_TAB_SWITCHER, selected).apply();
+        showRelaunchDialog();
+    }
+
+    private RadioButtonWithDescription button(PreferenceViewHolder holder, int id) {
+        return (RadioButtonWithDescription) holder.findViewById(id);
+    }
+
+    private void showRelaunchDialog() {
+        Activity activity = mActivity;
+        if (activity == null || activity.isFinishing()) return;
+        boolean ja = Locale.getDefault().getLanguage().equals("ja");
+        new AlertDialog.Builder(activity)
+                .setTitle(ja ? "再起動して適用" : "Restart to apply")
+                .setMessage(
+                        ja
+                                ? "タブ切り替え方式を変更しました。今すぐブラウザを再起動しますか？"
+                                : "The tab switcher mode was changed. Restart the browser now?")
+                .setPositiveButton(
+                        ja ? "再起動" : "Restart",
+                        (dialog, which) -> ApplicationLifetime.terminate(true))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+}
