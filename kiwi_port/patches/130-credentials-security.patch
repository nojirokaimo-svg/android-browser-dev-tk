@@ -2590,6 +2592,28 @@ void MigrateObsoleteProfilePrefs(PrefService* profile_prefs,
 #endif  // BUILDFLAG(ENABLE_WEBUI_NTP)
 
 #if BUILDFLAG(IS_ANDROID)
+#if BUILDFLAG(USE_LOGIN_DATABASE_AS_BACKEND)
+  // Titanium previously inherited Vanadium's platform-Autofill default. Move
+  // existing profiles to the restored local LoginDatabase backend exactly
+  // once so save/update prompts and persisted filling are enabled. Managed
+  // values remain authoritative, and after this marker is set the user's
+  // explicit Autofill choice is never overwritten on later starts.
+  if (!profile_prefs->GetBoolean(
+          password_manager::prefs::kTitaniumLocalPasswordBackendMigrated)) {
+    if (!profile_prefs->IsManagedPreference(
+            password_manager::prefs::kCredentialsEnableService)) {
+      profile_prefs->SetBoolean(
+          password_manager::prefs::kCredentialsEnableService, true);
+    }
+    if (!profile_prefs->IsManagedPreference(
+            autofill::prefs::kAutofillUsingPlatformAutofill)) {
+      profile_prefs->SetBoolean(
+          autofill::prefs::kAutofillUsingPlatformAutofill, false);
+    }
+    profile_prefs->SetBoolean(
+        password_manager::prefs::kTitaniumLocalPasswordBackendMigrated, true);
+  }
+#endif  // BUILDFLAG(USE_LOGIN_DATABASE_AS_BACKEND)
   // Added 09/2025.
   profile_prefs->ClearPref(kObsoleteUpmUnmigratedPasswordsExported);
   profile_prefs->ClearPref(kObsoletePasswordsUseUPMLocalAndSeparateStores);
