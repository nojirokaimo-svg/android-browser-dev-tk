+import java.security.KeyPairGenerator;
+import java.security.MessageDigest;
+import java.security.Signature;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Enumeration;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.zip.CRC32;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipFile;
+import java.util.zip.ZipException;
+import java.util.zip.ZipOutputStream;
+
+/** Packages a locally selected extension ZIP as a locally signed CRX3. */
+final class KiwiCrxPacker {
+    private static final int MAX_ENTRIES = 10000;
+    private static final long MAX_EXPANDED_BYTES = 256L * 1024L * 1024L;
+    private static final byte[] SIGNATURE_CONTEXT =
+            "CRX3 SignedData\0".getBytes(StandardCharsets.US_ASCII);
+
+    private KiwiCrxPacker() {}
+
+    static boolean hasCrxMagic(File file) throws IOException {
+        try (InputStream input = new FileInputStream(file)) {
+            return input.read() == 'C' && input.read() == 'r'
+                    && input.read() == '2' && input.read() == '4';
+        }
+    }
+
+    static boolean hasZipMagic(File file) throws IOException {
+        try (InputStream input = new FileInputStream(file)) {
+            int a = input.read();
+            int b = input.read();
+            int c = input.read();
+            int d = input.read();
+            return a == 'P' && b == 'K' && ((c == 3 && d == 4) || (c == 5 && d == 6));
+        }
+    }
+
+    /** The caller owns the returned file; failed operations remove their temporary output. */
+    static File pack(File source, File temporaryDirectory) throws IOException {
+        File normalized = File.createTempFile("kiwi-extension-normalized-", ".zip", temporaryDirectory);
+        File result = null;
+        boolean success = false;
+        try {
+            normalize(source, normalized);
+            result = File.createTempFile("kiwi-extension-package-", ".crx", temporaryDirectory);
+            writeCrx(normalized, result);
+            success = true;
+            return result;
+        } catch (GeneralSecurityException e) {
+            throw new IOException("Could not sign the extension package", e);
+        } finally {
+            normalized.delete();
+            if (!success && result != null) result.delete();
+        }
+    }
+
+    private static void validateName(String name) throws IOException {
+        if (name.isEmpty() || name.startsWith("/") || name.indexOf('\\') >= 0
+                || name.indexOf('\0') >= 0 || name.length() > 4096) {
+            throw new IOException("Unsafe ZIP entry name");
+        }
+        String[] components = name.split("/", -1);
+        for (int i = 0; i < components.length; i++) {
+            String part = components[i];
+            if (part.equals(".") || part.equals("..")
+                    || (part.isEmpty() && i != components.length - 1)
+                    || (i == 0 && part.indexOf(':') >= 0)) {
+                throw new IOException("Unsafe ZIP entry path");
+            }
+        }
+    }
+
+    private static String canonicalName(ZipEntry entry) {
+        String name = entry.getName();
+        while (name.startsWith("./")) name = name.substring(2);
+        return name;
+    }
+
+    private static void normalize(File source, File destination) throws IOException {
+        try (ZipFile zip = openZip(source)) {
+            List<? extends ZipEntry> entries = listEntries(zip);
+            String prefix = extensionPrefix(entries);
+            long total = 0;
+            try (ZipOutputStream out =
+                    new ZipOutputStream(new BufferedOutputStream(new FileOutputStream(destination)))) {
+                byte[] buffer = new byte[64 * 1024];
+                for (ZipEntry entry : entries) {
+                    String name = canonicalName(entry);
+                    if (!name.startsWith(prefix) || name.length() == prefix.length()) continue;
+                    String relative = name.substring(prefix.length());
+                    if (relative.startsWith("__MACOSX/")) continue;
+                    ZipEntry copy = new ZipEntry(relative);
+                    out.putNextEntry(copy);
+                    if (entry.isDirectory()) {
+                        out.closeEntry();
+                        continue;
+                    }
+                    CRC32 crc = new CRC32();
+                    long entrySize = 0;
+                    try (InputStream input = new BufferedInputStream(zip.getInputStream(entry))) {
+                        int read;
+                        while ((read = input.read(buffer)) != -1) {
+                            entrySize += read;
+                            total += read;
+                            if (total > MAX_EXPANDED_BYTES) {
+                                throw new IOException("Extension ZIP expands beyond 256 MB");
+                            }
+                            crc.update(buffer, 0, read);
+                            out.write(buffer, 0, read);
+                        }
+                    }
+                    if ((entry.getSize() >= 0 && entrySize != entry.getSize())
+                            || (entry.getCrc() >= 0 && crc.getValue() != entry.getCrc())) {
+                        throw new IOException("Extension ZIP is damaged");
+                    }
+                    out.closeEntry();
+                }
+            }
+        }
+    }
+
+    private static ZipFile openZip(File source) throws IOException {
+        try {
+            return new ZipFile(source, StandardCharsets.UTF_8);
+        } catch (ZipException | IllegalArgumentException utf8Error) {
+            // Older Windows ZIP tools may use Japanese Windows-31J filenames
+            // without setting the UTF-8 flag. ZipFile still honors that flag
+            // for archives that explicitly declare UTF-8.
+            try {
+                return new ZipFile(source, Charset.forName("windows-31j"));
+            } catch (IllegalArgumentException legacyError) {
+                throw new IOException("Invalid ZIP filename encoding", legacyError);
+            }
+        }
+    }
+
+    private static List<? extends ZipEntry> listEntries(ZipFile zip) throws IOException {
+        List<ZipEntry> entries = new ArrayList<>();
+        Set<String> names = new HashSet<>();
+        Enumeration<? extends ZipEntry> iterator = zip.entries();
+        while (iterator.hasMoreElements()) {
+            ZipEntry entry = iterator.nextElement();
+            String name = canonicalName(entry);
+            if (name.isEmpty() && entry.isDirectory()) continue;
+            validateName(name);
+            if (!names.add(name)) throw new IOException("Duplicate ZIP entry");
+            entries.add(entry);
+            if (entries.size() > MAX_ENTRIES) throw new IOException("Too many ZIP entries");
+        }
+        return entries;
+    }
+
+    private static String extensionPrefix(List<? extends ZipEntry> entries) throws IOException {
+        String prefix = null;
+        int depth = Integer.MAX_VALUE;
+        boolean ambiguous = false;
+        for (ZipEntry entry : entries) {
+            String name = canonicalName(entry);
+            if (entry.isDirectory() || name.startsWith("__MACOSX/")) continue;
+            if (!name.equals("manifest.json") && !name.endsWith("/manifest.json")) continue;
+            String candidate = name.substring(0, name.length() - "manifest.json".length());
+            int candidateDepth = 0;
+            for (int i = 0; i < candidate.length(); i++) {
+                if (candidate.charAt(i) == '/') candidateDepth++;
+            }
+            if (candidateDepth < depth) {
+                prefix = candidate;
+                depth = candidateDepth;
+                ambiguous = false;
+            } else if (candidateDepth == depth && !candidate.equals(prefix)) {
+                ambiguous = true;
+            }
+        }
+        if (prefix == null) throw new IOException("manifest.json was not found in the ZIP");
+        if (ambiguous) throw new IOException("ZIP contains multiple extension folders");
+        return prefix;
+    }
+
+    private static void writeCrx(File zip, File destination)
+            throws IOException, GeneralSecurityException {
+        KeyPairGenerator generator = KeyPairGenerator.getInstance("RSA");
+        generator.initialize(2048);
+        KeyPair pair = generator.generateKeyPair();
+        byte[] publicKey = pair.getPublic().getEncoded();
+        byte[] id = Arrays.copyOf(MessageDigest.getInstance("SHA-256").digest(publicKey), 16);
+        byte[] signedHeader = field(1, id);
+        Signature signer = Signature.getInstance("SHA256withRSA");
+        signer.initSign(pair.getPrivate());
+        signer.update(SIGNATURE_CONTEXT);
+        signer.update(littleEndian(signedHeader.length));
+        signer.update(signedHeader);
+        try (InputStream input = new BufferedInputStream(new FileInputStream(zip))) {
+            byte[] buffer = new byte[64 * 1024];
+            int count;
+            while ((count = input.read(buffer)) != -1) signer.update(buffer, 0, count);
+        }
+        byte[] proof = concat(field(1, publicKey), field(2, signer.sign()));
+        byte[] header = concat(field(2, proof), field(10000, signedHeader));
+        try (OutputStream output = new BufferedOutputStream(new FileOutputStream(destination));
+                InputStream input = new BufferedInputStream(new FileInputStream(zip))) {
+            output.write(new byte[] {'C', 'r', '2', '4'});
+            output.write(littleEndian(3));
+            output.write(littleEndian(header.length));
+            output.write(header);
+            byte[] buffer = new byte[64 * 1024];
+            int count;
+            while ((count = input.read(buffer)) != -1) output.write(buffer, 0, count);
+        }
+    }
+
+    private static byte[] littleEndian(int value) {
+        return new byte[] {(byte) value, (byte) (value >>> 8), (byte) (value >>> 16),
+                (byte) (value >>> 24)};
+    }
+
+    private static void writeVarint(OutputStream out, int value) throws IOException {
+        while ((value & ~0x7f) != 0) {
+            out.write((value & 0x7f) | 0x80);
+            value >>>= 7;
+        }
+        out.write(value);
+    }
+
+    private static byte[] field(int number, byte[] data) throws IOException {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        writeVarint(out, (number << 3) | 2);
+        writeVarint(out, data.length);
+        out.write(data);
+        return out.toByteArray();
+    }
+
+    private static byte[] concat(byte[] first, byte[] second) throws IOException {
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        out.write(first);
+        out.write(second);
+        return out.toByteArray();
+    }
+}
