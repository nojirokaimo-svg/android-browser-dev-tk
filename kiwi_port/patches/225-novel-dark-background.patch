+    // The appearance preference normally colors browser UI. Hameln
+    // renders its own page backgrounds, so apply the same color after page load.
+    private void applyKiwiHamelnDarkBackground(Tab tab, GURL url) {
+        if (tab == null || url == null || !"https".equals(url.getScheme())) return;
+        String host = url.getHost();
+        if (!("syosetu.org".equals(host) || host.endsWith(".syosetu.org"))) return;
+        WebContents contents = tab.getWebContents();
+        if (contents == null) return;
+        Profile profile = Profile.fromWebContents(contents);
+        if (profile == null) return;
+        if (!WebContentsDarkModeController.isGlobalUserSettingsEnabled(profile)
+                || !WebContentsDarkModeController.isEnabledForUrl(profile, url)) {
+            contents.evaluateJavaScript(
+                    "(function(){let style=document.getElementById('kiwi-novel-dark-page');"
+                            + "if(style)style.remove()})();", null);
+            return;
+        }
+        String color = getApplicationContext()
+                .getSharedPreferences("kiwi_ui_color", Context.MODE_PRIVATE)
+                .getString("dark_surface_hex", "#000000");
+        if (color == null || !color.matches("#[0-9a-fA-F]{6}")) color = "#000000";
+        // The validated hex value is the only dynamic script input. Restrict
+        // injection to syosetu.org pages and respect per-site Night mode.
+        contents.evaluateJavaScript(
+                "(function(){const color='" + color + "';"
+                        + "const css='html,body,body>div,main,article,#main,#contents,"
+                        + "#novel,#honbun,.contents,.novel{background-color:'"
+                        + "+color+'!important}';"
+                        + "let style=document.getElementById('kiwi-novel-dark-page');"
+                        + "if(!style){style=document.createElement('style');"
+                        + "style.id='kiwi-novel-dark-page';"
+                        + "(document.head||document.documentElement).appendChild(style)}"
+                        + "style.textContent=css})();", null);
     }
 
