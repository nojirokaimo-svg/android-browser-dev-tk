+static jni_zero::ScopedJavaLocalRef<jstring>
+JNI_KiwiMigrationActivity_ImportMigrationData(
+    JNIEnv* env,
+    Profile* profile,
+    const base::android::JavaParamRef<jstring>& j_json) {
+  return base::android::ConvertUTF8ToJavaString(
+      env, ImportMigrationData(
+               profile, base::android::ConvertJavaStringToUTF8(env, j_json)));
+}
+
+static jboolean JNI_KiwiMigrationActivity_InstallExtensionFile(
+    JNIEnv* env,
+    Profile* profile,
+    const base::android::JavaParamRef<jstring>& j_path) {
+  base::FilePath path = base::FilePath::FromUTF8Unsafe(
+      base::android::ConvertJavaStringToUTF8(env, j_path));
+  if (!base::PathExists(path)) {
+    return false;
+  }
+  if (path.MatchesExtension(FILE_PATH_LITERAL(".zip"))) {
+    extensions::ExtensionRegistrar* registrar =
+        extensions::ExtensionRegistrar::Get(profile);
+    extensions::ZipFileInstaller::Create(
+        extensions::GetExtensionFileTaskRunner(),
+        extensions::MakeRegisterInExtensionServiceCallback(profile))
+        ->InstallZipFileToUnpackedExtensionsDir(
+            path, registrar->unpacked_install_directory());
+    return true;
+  }
+  if (path.MatchesExtension(FILE_PATH_LITERAL(".crx"))) {
+    scoped_refptr<extensions::CrxInstaller> installer =
+        extensions::CrxInstaller::CreateSilent(profile);
+    installer->set_error_on_unsupported_requirements(true);
+    installer->set_off_store_install_allow_reason(
+        extensions::CrxInstaller::OffStoreInstallAllowedFromSettingsPage);
+    installer->set_install_immediately(true);
+    installer->InstallCrx(path);
+    return true;
+  }
+  return false;
+}
+
+static jboolean JNI_KiwiMigrationActivity_LoadUnpacked(
+    JNIEnv* env,
+    Profile* profile,
+    const base::android::JavaParamRef<jstring>& j_uri) {
+  base::FilePath uri = base::FilePath::FromUTF8Unsafe(
+      base::android::ConvertJavaStringToUTF8(env, j_uri));
+  std::optional<base::FilePath> virtual_path =
+      base::ResolveToVirtualDocumentPath(uri);
+  if (!virtual_path) {
+    return false;
+  }
+  scoped_refptr<extensions::UnpackedInstaller> installer =
+      extensions::UnpackedInstaller::Create(profile);
+  installer->set_be_noisy_on_failure(true);
+  installer->Load(*virtual_path);
+  return true;
+}
