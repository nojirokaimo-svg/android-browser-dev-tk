+import org.json.JSONObject;
+
+import org.chromium.base.ApplicationStatus;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.browser.ChromeTabbedActivity;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.profiles.ProfileManager;
+import org.chromium.chrome.browser.tab.TabLaunchType;
+import org.chromium.content_public.browser.LoadUrlParams;
+import org.jni_zero.JNINamespace;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import java.io.BufferedInputStream;
+import java.io.BufferedOutputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Set;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipOutputStream;
+
+/** End-to-end Kiwi Browser migration and Android extension package loading. */
+@NullMarked
+@JNINamespace("chrome::android")
+public final class KiwiMigrationActivity extends Activity {
+    private static final int CREATE_EXPORTER = 9201;
+    private static final int OPEN_MIGRATION = 9202;
+    private static final int OPEN_EXTENSION_PACKAGE = 9203;
+    private static final int OPEN_UNPACKED_EXTENSION = 9204;
+    private static final long MAX_MIGRATION_BYTES = 128L * 1024L * 1024L;
+
+    private TextView mStatus;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setTitle(isJapanese() ? "Kiwi Browserから移行" : "Migrate from Kiwi Browser");
+        setContentView(createContent());
+    }
+
+    private View createContent() {
+        ScrollView scroll = new ScrollView(this);
+        LinearLayout root = new LinearLayout(this);
+        root.setOrientation(LinearLayout.VERTICAL);
+        root.setPadding(dp(24), dp(24), dp(24), dp(40));
+        root.setBackgroundColor(Color.BLACK);
+        scroll.addView(root);
+
+        TextView title = text(isJapanese() ? "Kiwi Browserから移行" : "Migrate from Kiwi Browser", 24);
+        title.setTextColor(Color.WHITE);
+        root.addView(title);
+        TextView help =
+                text(
+                        isJapanese()
+                                ? "Kiwiで書き出したデータをTitaniumへ直接取り込みます。ログイン状態やCookieは移行しません。"
+                                : "Import Kiwi data directly into Titanium. Sign-in state and cookies are not migrated.",
+                        15);
+        help.setTextColor(0xffbdbdbd);
+        help.setPadding(0, dp(8), 0, dp(20));
+        root.addView(help);
+
+        root.addView(
+                button(
+                        isJapanese() ? "1. Kiwi用書き出し拡張を保存" : "1. Save Kiwi exporter extension",
+                        v -> createExporter()));
+        root.addView(
+                button(
+                        isJapanese() ? "2. Kiwiの移行ファイルを読み込む" : "2. Import Kiwi migration file",
+                        v -> chooseMigration()));
+        root.addView(
+                button(
+                        isJapanese() ? "ZIP / CRX拡張を読み込む" : "Load ZIP / CRX extension",
+                        v -> chooseExtensionPackage()));
+        root.addView(
+                button(
+                        isJapanese() ? "展開済み拡張を読み込む" : "Load unpacked extension",
+                        v -> chooseUnpackedExtension()));
+
+        mStatus = text(isJapanese() ? "準備完了" : "Ready", 14);
+        mStatus.setTextColor(0xff9aa0a6);
+        mStatus.setPadding(0, dp(20), 0, 0);
+        root.addView(mStatus);
+        return scroll;
+    }
+
+    private Button button(String label, View.OnClickListener listener) {
+        Button button = new Button(this);
+        button.setText(label);
+        button.setAllCaps(false);
+        button.setTextSize(16);
+        button.setGravity(Gravity.START | Gravity.CENTER_VERTICAL);
+        button.setOnClickListener(listener);
+        LinearLayout.LayoutParams params =
+                new LinearLayout.LayoutParams(
+                        LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT);
+        params.setMargins(0, dp(6), 0, dp(6));
+        button.setLayoutParams(params);
+        return button;
+    }
+
+    private TextView text(String value, int size) {
+        TextView view = new TextView(this);
+        view.setText(value);
+        view.setTextSize(size);
+        return view;
+    }
+
+    private void createExporter() {
+        Intent intent = new Intent(Intent.ACTION_CREATE_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType("application/zip");
+        intent.putExtra(Intent.EXTRA_TITLE, "titanium-kiwi-exporter.zip");
+        startActivityForResult(intent, CREATE_EXPORTER);
+    }
+
+    private void chooseMigration() {
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType("application/json");
+        startActivityForResult(intent, OPEN_MIGRATION);
+    }
+
+    private void chooseExtensionPackage() {
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT);
+        intent.addCategory(Intent.CATEGORY_OPENABLE);
+        intent.setType("application/octet-stream");
+        intent.putExtra(
+                Intent.EXTRA_MIME_TYPES,
+                new String[] {"application/zip", "application/x-chrome-extension", "application/octet-stream"});
+        startActivityForResult(intent, OPEN_EXTENSION_PACKAGE);
+    }
+
+    private void chooseUnpackedExtension() {
+        Intent intent = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
+        intent.addFlags(
+                Intent.FLAG_GRANT_READ_URI_PERMISSION
+                        | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
+        startActivityForResult(intent, OPEN_UNPACKED_EXTENSION);
+    }
+
+    @Override
+    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
+        super.onActivityResult(requestCode, resultCode, data);
+        if (resultCode != RESULT_OK || data == null || data.getData() == null) return;
+        Uri uri = data.getData();
+        if (requestCode == CREATE_EXPORTER) {
+            saveExporter(uri);
+        } else if (requestCode == OPEN_MIGRATION) {
+            importMigration(uri);
+        } else if (requestCode == OPEN_EXTENSION_PACKAGE) {
+            installPackage(uri);
+        } else if (requestCode == OPEN_UNPACKED_EXTENSION) {
+            try {
+                getContentResolver()
+                        .takePersistableUriPermission(uri, Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            } catch (SecurityException ignored) {
+            }
+            boolean started =
+                    KiwiMigrationActivityJni.get().loadUnpacked(profile(), uri.toString());
+            setStatus(
+                    started
+                            ? (isJapanese() ? "展開済み拡張の読み込みを開始しました" : "Loading unpacked extension")
+                            : (isJapanese() ? "フォルダを読み込めませんでした" : "Unable to load folder"));
+        }
+    }
+
+    private void saveExporter(Uri uri) {
+        setStatus(isJapanese() ? "書き出し拡張を作成中…" : "Creating exporter…");
+        new Thread(
+                        () -> {
+                            try (OutputStream output = getContentResolver().openOutputStream(uri, "w")) {
+                                if (output == null) throw new IOException("Unable to open destination");
+                                writeExporterZip(output);
+                                setStatus(isJapanese() ? "保存しました。KiwiでZIPを読み込んで実行してください" : "Saved. Load the ZIP in Kiwi and run it");
+                            } catch (IOException exception) {
+                                setStatus((isJapanese() ? "保存失敗: " : "Save failed: ") + exception.getMessage());
+                            }
+                        },
+                        "KiwiExporterWriter")
+                .start();
+    }
+
+    private void importMigration(Uri uri) {
+        setStatus(isJapanese() ? "移行データを読み込み中…" : "Importing migration data…");
+        new Thread(
+                        () -> {
+                            try {
+                                String json = readUtf8(uri, MAX_MIGRATION_BYTES);
+                                JSONObject root = new JSONObject(json);
+                                if (!"titanium-kiwi-migration-v1".equals(root.optString("format"))) {
+                                    throw new IOException("Unsupported migration format");
+                                }
+                                runOnUiThread(() -> completeMigrationImport(json, root));
+                            } catch (IOException | JSONException exception) {
+                                setStatus((isJapanese() ? "取り込み失敗: " : "Import failed: ") + exception.getMessage());
+                            }
+                        },
+                        "KiwiMigrationImport")
+                .start();
+    }
+
+    private void completeMigrationImport(String json, JSONObject root) {
+        String nativeResult =
+                KiwiMigrationActivityJni.get().importMigrationData(profile(), json);
+        if (!nativeResult.startsWith("OK|")) {
+            setStatus((isJapanese() ? "取り込み失敗: " : "Import failed: ") + nativeResult);
+            return;
+        }
+        try {
+            int openedTabs = openExportedTabs(root);
+            String[] fields = nativeResult.split("\\|", -1);
+            String message =
+                    isJapanese()
+                            ? "完了: ブックマーク "
+                                    + fields[1]
+                                    + "件、履歴訪問 "
+                                    + fields[2]
+                                    + "件、タブ "
+                                    + openedTabs
+                                    + "件"
+                            : "Done: "
+                                    + fields[1]
+                                    + " bookmarks, "
+                                    + fields[2]
+                                    + " history visits, "
+                                    + openedTabs
+                                    + " tabs";
+            setStatus(message);
+        } catch (JSONException exception) {
+            setStatus((isJapanese() ? "タブ取り込み失敗: " : "Tab import failed: ") + exception.getMessage());
+        }
+    }
+
+    private int openExportedTabs(JSONObject root) throws JSONException {
+        Set<String> urls = new HashSet<>();
+        collectTabs(root.optJSONArray("tabs"), urls);
+        JSONArray recent = root.optJSONArray("recentlyClosed");
+        if (recent != null) {
+            for (int i = 0; i < recent.length(); i++) {
+                JSONObject session = recent.optJSONObject(i);
+                if (session == null) continue;
+                JSONObject tab = session.optJSONObject("tab");
+                if (tab != null) addUrl(tab.optString("url"), urls);
+                JSONObject window = session.optJSONObject("window");
+                if (window != null) collectTabs(window.optJSONArray("tabs"), urls);
+            }
+        }
+        if (urls.isEmpty()) return 0;
+        ChromeTabbedActivity activity = findTabbedActivity();
+        if (activity == null) {
+            Toast.makeText(
+                            this,
+                            isJapanese() ? "タブ画面へ戻って再度取り込んでください" : "Return to the tab screen and import again",
+                            Toast.LENGTH_LONG)
+                    .show();
+            return 0;
+        }
+        for (String url : urls) {
+            activity.getTabCreator(false)
+                    .createNewTab(
+                            new LoadUrlParams(url),
+                            TabLaunchType.FROM_LONGPRESS_BACKGROUND,
+                            null);
+        }
+        return urls.size();
+    }
+
+    private static void collectTabs(JSONArray tabs, Set<String> urls) {
+        if (tabs == null) return;
+        for (int i = 0; i < tabs.length(); i++) {
+            JSONObject tab = tabs.optJSONObject(i);
+            if (tab != null) addUrl(tab.optString("url"), urls);
+        }
+    }
+
+    private static void addUrl(String url, Set<String> urls) {
+        if (url.startsWith("http://") || url.startsWith("https://")) urls.add(url);
+    }
+
+    private static ChromeTabbedActivity findTabbedActivity() {
+        List<Activity> activities = ApplicationStatus.getRunningActivities();
+        for (Activity activity : activities) {
+            if (activity instanceof ChromeTabbedActivity) return (ChromeTabbedActivity) activity;
+        }
+        return null;
+    }
+
+    private void installPackage(Uri uri) {
+        setStatus(isJapanese() ? "拡張パッケージを準備中…" : "Preparing extension package…");
+        new Thread(
+                        () -> {
+                            File temporary = null;
+                            try {
+                                String name = displayName(uri).toLowerCase(Locale.ROOT);
+                                String suffix;
+                                if (name.endsWith(".zip")) suffix = ".zip";
+                                else if (name.endsWith(".crx")) suffix = ".crx";
+                                else throw new IOException("Select a .zip or .crx file");
+                                temporary = File.createTempFile("kiwi-extension-", suffix, getCacheDir());
+                                copyUri(uri, temporary, MAX_MIGRATION_BYTES);
+                                File packageFile = temporary;
+                                runOnUiThread(
+                                        () -> {
+                                            boolean started =
+                                                    KiwiMigrationActivityJni.get()
+                                                            .installExtensionFile(
+                                                                    profile(), packageFile.getAbsolutePath());
+                                            setStatus(
+                                                    started
+                                                            ? (isJapanese()
+                                                                    ? "拡張機能のインストールを開始しました"
+                                                                    : "Extension installation started")
+                                                            : (isJapanese()
+                                                                    ? "インストーラがパッケージを拒否しました"
+                                                                    : "Installer rejected the package"));
+                                        });
+                            } catch (IOException exception) {
+                                if (temporary != null) temporary.delete();
+                                setStatus((isJapanese() ? "読み込み失敗: " : "Load failed: ") + exception.getMessage());
+                            }
+                        },
+                        "KiwiExtensionInstall")
+                .start();
+    }
+
+    private Profile profile() {
+        return ProfileManager.getLastUsedRegularProfile().getOriginalProfile();
+    }
+
+    private String displayName(Uri uri) {
+        try (Cursor cursor =
+                getContentResolver().query(uri, new String[] {OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+            if (cursor != null && cursor.moveToFirst()) return cursor.getString(0);
+        }
+        String segment = uri.getLastPathSegment();
+        return segment == null ? "" : segment;
+    }
+
+    private String readUtf8(Uri uri, long limit) throws IOException {
+        try (InputStream input = new BufferedInputStream(getContentResolver().openInputStream(uri));
+                ByteArrayOutputStream output = new ByteArrayOutputStream()) {
+            if (input == null) throw new IOException("Unable to open file");
+            byte[] buffer = new byte[64 * 1024];
+            long total = 0;
+            int count;
+            while ((count = input.read(buffer)) != -1) {
+                total += count;
+                if (total > limit) throw new IOException("Migration file is too large");
+                output.write(buffer, 0, count);
+            }
+            return output.toString(StandardCharsets.UTF_8.name());
+        }
+    }
+
+    private void copyUri(Uri uri, File target, long limit) throws IOException {
+        try (InputStream input = new BufferedInputStream(getContentResolver().openInputStream(uri));
+                OutputStream output = new BufferedOutputStream(new FileOutputStream(target))) {
+            if (input == null) throw new IOException("Unable to open file");
+            byte[] buffer = new byte[64 * 1024];
+            long total = 0;
+            int count;
+            while ((count = input.read(buffer)) != -1) {
+                total += count;
+                if (total > limit) throw new IOException("Extension package is too large");
+                output.write(buffer, 0, count);
+            }
+        }
+    }
+
+    private static void writeExporterZip(OutputStream destination) throws IOException {
+        try (ZipOutputStream zip = new ZipOutputStream(new BufferedOutputStream(destination))) {
+            writeZipEntry(zip, "manifest.json", EXPORTER_MANIFEST);
+            writeZipEntry(zip, "popup.html", EXPORTER_HTML);
+            writeZipEntry(zip, "popup.js", EXPORTER_JS);
+        }
+    }
+
+    private static void writeZipEntry(ZipOutputStream zip, String name, String value)
+            throws IOException {
+        zip.putNextEntry(new ZipEntry(name));
+        zip.write(value.replace("\\n", "\n").getBytes(StandardCharsets.UTF_8));
+        zip.closeEntry();
+    }
+
+    private void setStatus(String message) {
+        runOnUiThread(() -> mStatus.setText(message));
+    }
+
+    private boolean isJapanese() {
+        return Locale.getDefault().getLanguage().equals("ja");
+    }
+
+    private int dp(int value) {
+        return Math.round(value * getResources().getDisplayMetrics().density);
+    }
+
+    private static final String EXPORTER_MANIFEST =
+            "{\n"
+                    + "  \"manifest_version\": 2,\n"
+                    + "  \"name\": \"Titanium Kiwi Migration Exporter\",\n"
+                    + "  \"version\": \"1.0\",\n"
+                    + "  \"permissions\": [\"bookmarks\", \"history\", \"tabs\", \"sessions\", \"downloads\", \"management\"],\n"
+                    + "  \"browser_action\": {\"default_popup\": \"popup.html\"}\n"
+                    + "}\n";
+
+    private static final String EXPORTER_HTML =
+            "<!doctype html><meta charset=\"utf-8\"><style>body{font:15px sans-serif;width:320px;padding:16px;background:#111;color:#eee}button{width:100%;padding:12px}</style><h2>Kiwi → Titanium</h2><p>ブックマーク、元日時付き履歴、タブをJSONへ書き出します。</p><button id=go>移行ファイルを書き出す</button><p id=status></p><script src=popup.js></script>";
+
+    private static final String EXPORTER_JS =
+            "const call=(fn,arg)=>new Promise((ok,ng)=>fn(arg,x=>chrome.runtime.lastError?ng(new Error(chrome.runtime.lastError.message)):ok(x)));\n"
+                    + "const noarg=fn=>new Promise((ok,ng)=>fn(x=>chrome.runtime.lastError?ng(new Error(chrome.runtime.lastError.message)):ok(x)));\n"
+                    + "document.getElementById('go').onclick=async()=>{const s=document.getElementById('status');try{s.textContent='履歴を収集中…';const bookmarks=await noarg(chrome.bookmarks.getTree);const items=await call(chrome.history.search,{text:'',startTime:0,maxResults:100000});const history=[];for(let i=0;i<items.length;i++){const item=items[i];const visits=await call(chrome.history.getVisits,{url:item.url});history.push({...item,visits});if(i%100===0)s.textContent=`履歴 ${i}/${items.length}`;}const tabs=await call(chrome.tabs.query,{});const recentlyClosed=await call(chrome.sessions.getRecentlyClosed,{maxResults:25});const downloads=await call(chrome.downloads.search,{});const extensions=await noarg(chrome.management.getAll);const data={format:'titanium-kiwi-migration-v1',exportedAt:Date.now(),bookmarks,history,tabs,recentlyClosed,downloads,extensions};const blob=new Blob([JSON.stringify(data)],{type:'application/json'});const url=URL.createObjectURL(blob);await call(chrome.downloads.download,{url,filename:`kiwi-migration-${new Date().toISOString().replace(/[:.]/g,'-')}.json`,saveAs:true});s.textContent='書き出しました';}catch(e){s.textContent='失敗: '+e.message;}};\\n";
+
+    @NativeMethods
+    interface Natives {
+        String importMigrationData(@JniType("Profile*") Profile profile, String json);
+
+        boolean installExtensionFile(@JniType("Profile*") Profile profile, String path);
+
+        boolean loadUnpacked(@JniType("Profile*") Profile profile, String uri);
+    }
+}
