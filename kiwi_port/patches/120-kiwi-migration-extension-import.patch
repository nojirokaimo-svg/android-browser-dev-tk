+void ImportBookmarkChildren(const base::Value::List& children,
+                            bookmarks::BookmarkModel* model,
+                            const bookmarks::BookmarkNode* parent,
+                            int* imported) {
+  for (const base::Value& value : children) {
+    if (!value.is_dict()) {
+      continue;
+    }
+    const base::Value::Dict& item = value.GetDict();
+    const std::string* title = item.FindString("title");
+    const std::string* url_string = item.FindString("url");
+    const base::Value::List* nested = item.FindList("children");
+    if (url_string) {
+      GURL url(*url_string);
+      if (url.is_valid() && (url.SchemeIsHTTPOrHTTPS())) {
+        model->AddURL(parent, parent->children().size(),
+                      base::UTF8ToUTF16(title ? *title : *url_string), url);
+        ++*imported;
+      }
+      continue;
+    }
+    if (!nested) {
+      continue;
+    }
+    const bookmarks::BookmarkNode* folder = model->AddFolder(
+        parent, parent->children().size(),
+        base::UTF8ToUTF16(title && !title->empty() ? *title : "Kiwi"));
+    ImportBookmarkChildren(*nested, model, folder, imported);
+  }
+}
+
+std::string ImportMigrationData(Profile* profile, const std::string& json) {
+  std::optional<base::Value> parsed = base::JSONReader::Read(json);
+  if (!parsed || !parsed->is_dict()) {
+    return "Invalid JSON";
+  }
+  const base::Value::Dict& root = parsed->GetDict();
+  const std::string* format = root.FindString("format");
+  if (!format || *format != "titanium-kiwi-migration-v1") {
+    return "Unsupported migration format";
+  }
+
+  bookmarks::BookmarkModel* model =
+      BookmarkModelFactory::GetForBrowserContext(profile);
+  if (!model || !model->loaded() || !model->mobile_node()) {
+    return "Bookmark model is not ready";
+  }
+  int bookmarks = 0;
+  if (const base::Value::List* roots = root.FindList("bookmarks")) {
+    const bookmarks::BookmarkNode* folder = model->AddFolder(
+        model->mobile_node(), model->mobile_node()->children().size(),
+        u"Kiwi Browserから移行");
+    for (const base::Value& value : *roots) {
+      if (!value.is_dict()) {
+        continue;
+      }
+      if (const base::Value::List* children = value.GetDict().FindList("children")) {
+        ImportBookmarkChildren(*children, model, folder, &bookmarks);
+      }
+    }
+  }
+
+  int visits = 0;
+  history::HistoryService* history_service =
+      HistoryServiceFactory::GetForProfile(profile,
+                                           ServiceAccessType::EXPLICIT_ACCESS);
+  if (history_service) {
+    if (const base::Value::List* history_items = root.FindList("history")) {
+      for (const base::Value& value : *history_items) {
+        if (!value.is_dict()) {
+          continue;
+        }
+        const base::Value::Dict& item = value.GetDict();
+        const std::string* url_string = item.FindString("url");
+        if (!url_string) {
+          continue;
+        }
+        GURL url(*url_string);
+        if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+          continue;
+        }
+        const std::string* title = item.FindString("title");
+        if (title && !title->empty()) {
+          history_service->SetPageTitle(url, base::UTF8ToUTF16(*title));
+        }
+        const base::Value::List* item_visits = item.FindList("visits");
+        if (!item_visits) {
+          continue;
+        }
+        for (const base::Value& visit : *item_visits) {
+          if (!visit.is_dict()) {
+            continue;
+          }
+          std::optional<double> milliseconds =
+              visit.GetDict().FindDouble("visitTime");
+          if (!milliseconds || *milliseconds <= 0) {
+            continue;
+          }
+          history_service->AddPage(
+              url, base::Time::FromMillisecondsSinceUnixEpoch(*milliseconds),
+              history::SOURCE_BROWSED);
+          ++visits;
+        }
+      }
+    }
+  }
+  return "OK|" + base::NumberToString(bookmarks) + "|" +
+         base::NumberToString(visits);
+}
