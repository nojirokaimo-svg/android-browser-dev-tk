diff --git a/components/omnibox/browser/autocomplete_controller.cc b/components/omnibox/browser/autocomplete_controller.cc
--- a/components/omnibox/browser/autocomplete_controller.cc
+++ b/components/omnibox/browser/autocomplete_controller.cc
@@ -1118,6 +1118,15 @@
     return false;
   }
 
+#if BUILDFLAG(IS_ANDROID)
+  // On a new tab Kiwi shows the clipboard suggestion alone until the user types.
+  // Keep the existing ClipboardProvider so URLs navigate and text searches work.
+  if (input_.IsZeroSuggest() &&
+      omnibox::IsNTPPage(input_.current_page_classification())) {
+    return provider->type() == AutocompleteProvider::TYPE_CLIPBOARD;
+  }
+#endif
+
   // If zero prefix suggest is disabled for the Lens contextual searchbox, only
   // run the typed search provider. Else, will use the IsLensSearchbox check
   // below.
diff --git a/components/omnibox/browser/clipboard_provider.cc b/components/omnibox/browser/clipboard_provider.cc
--- a/components/omnibox/browser/clipboard_provider.cc
+++ b/components/omnibox/browser/clipboard_provider.cc
@@ -156,6 +156,15 @@
     return;
   }
 
+#if BUILDFLAG(IS_ANDROID)
+  // Keep clipboard suggestions short-lived outside the new-tab omnibox. On a
+  // new tab, offer the link while Android retains the clipboard item.
+  if (!omnibox::IsNTPPage(page_class) &&
+      clipboard_content_->GetClipboardContentAge() > base::Minutes(10)) {
+    return;
+  }
+#endif
+
   done_ = true;
 
   // On iOS and Android, accessing the clipboard contents shows a notification
@@ -217,14 +226,9 @@
                                            matches_.empty(), match.type,
                                            clipboard_contents_age);
 
-  if (is_android && omnibox::IsNTPPage(input.current_page_classification())) {
-    // Assign the Clipboard to the PZPS group on NTP pages to improve the use
-    // of the suggest space.
-    match.suggestion_group_id = omnibox::GROUP_PERSONALIZED_ZERO_SUGGEST;
-  } else {
-    // Leave the clipboard in its dedicated section otherwise.
-    match.suggestion_group_id = omnibox::GROUP_MOBILE_CLIPBOARD;
-  }
+  // The Android NTP has a dedicated clipboard group with a guaranteed slot.
+  // The personalized suggestions group can be disabled by field trial.
+  match.suggestion_group_id = omnibox::GROUP_MOBILE_CLIPBOARD;
 
   matches_.push_back(match);
 }
