+    private @Nullable String readKiwiClipboardText() {
+        try {
+            ClipboardManager clipboard =
+                    (ClipboardManager) mContext.getSystemService(Context.CLIPBOARD_SERVICE);
+            ClipData data = clipboard == null ? null : clipboard.getPrimaryClip();
+            if (data == null || data.getItemCount() == 0) return null;
+            // Reading after the user's tap avoids Android's unsolicited clipboard
+            // notification. Do not coerce content:// URIs into readable file content.
+            ClipData.Item item = data.getItemAt(0);
