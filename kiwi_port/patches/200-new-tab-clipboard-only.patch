 void ClipboardProvider::CheckClipboardContent(const AutocompleteInput& input) {
+#if BUILDFLAG(IS_ANDROID)
+  if (ntp_clipboard_mode_) {
+    // Android may not have delivered the clipboard timestamp to native code
+    // yet, and a field trial may impose a shorter maximum age. Neither should
+    // hide a link that is still present when the user focuses a new tab.
+    // Query formats only: reading the value here would trigger Android's
+    // clipboard access notification before the user selects the suggestion.
+    done_ = false;
+    ui::DataTransferEndpoint data_dst(
+        ui::EndpointType::kDefault, {.notify_if_restricted = false});
+    ui::Clipboard::GetForCurrentThread()->GetAvailableFormats(
+        ui::ClipboardBuffer::kCopyPaste,
+        {ui::ClipboardFormatType::UrlType(),
+         ui::ClipboardFormatType::PlainTextType()},
+        data_dst,
+        base::BindOnce(
+            [](base::WeakPtr<ClipboardProvider> provider,
+               AutocompleteInput input,
+               base::flat_set<ui::ClipboardFormatType> formats) {
+              if (!provider) return;
+              std::set<ClipboardContentType> types;
+              if (formats.contains(ui::ClipboardFormatType::UrlType()) ||
+                  formats.contains(ui::ClipboardFormatType::PlainTextType())) {
+                // Android often labels copied URLs as plain text until its
+                // classifier finishes. Read the text only after selection.
+                types.insert(ClipboardContentType::URL);
+              }
+              provider->OnReceiveClipboardContent(
+                  input, provider->clipboard_content_->GetClipboardContentAge(),
+                  types);
+            },
+            callback_weak_ptr_factory_.GetWeakPtr(), input));
+    return;
+  }
+#endif
   std::set<ClipboardContentType> desired_types;
   desired_types.insert(ClipboardContentType::URL);
 
