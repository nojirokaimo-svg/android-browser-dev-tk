+    public List<AppMenuAction> getAppMenuActions() {
+        List<AppMenuAction> items = new ArrayList<>();
+        if (mIsDestroyed || mProfile.shutdownStarted() || mCurrentTabSupplier == null) {
+            return items;
+        }
+        Tab tab = mCurrentTabSupplier.get();
+        if (tab == null || tab.getWebContents() == null) return items;
+
+        // Respect the user's pinned order, then include every remaining action.
+        // A set also prevents a pinned extension from being listed twice.
+        LinkedHashSet<String> ids = new LinkedHashSet<>(
+                Arrays.asList(mExtensionsToolbarBridge.getPinnedActionIds()));
+        ids.addAll(Arrays.asList(mExtensionsToolbarBridge.getAllActionIds()));
+        for (String id : ids) {
+            var action = mExtensionsToolbarBridge.getAction(id, tab.getWebContents());
+            if (action == null) continue;
+            var icon = ExtensionActionIconUtil.getIcon(mContainer.getContext(),
+                    mWindowAndroid, mExtensionsToolbarBridge, id, tab.getWebContents());
+            items.add(new AppMenuAction(id, action.getName(), action.getAccessibleName(),
+                    icon, tab.getId()));
+        }
+        return items;
+    }
