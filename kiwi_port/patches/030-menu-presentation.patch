+    private static int getKiwiMenuBackgroundColor(Context context) {
+        int menuBgColor = SemanticColorUtils.getMenuBgColor(context);
+        boolean isDark =
+                Color.red(menuBgColor) * 299
+                                + Color.green(menuBgColor) * 587
+                                + Color.blue(menuBgColor) * 114
+                        < 128000;
+        return isDark ? Color.rgb(32, 33, 36) : menuBgColor;
+    }
+
+    private static void tintKiwiMenuBackgrounds(
+            Context context, ViewGroup contentView, ViewGroup innerContainer) {
+        int menuBgColor = getKiwiMenuBackgroundColor(context);
+        var sharedDrawable = AppCompatResources.getDrawable(context, R.drawable.popup_bg_8dp);
+        if (sharedDrawable != null) {
+            var outerBackground = sharedDrawable.mutate();
+            outerBackground.setTint(menuBgColor);
+            outerBackground.setTintMode(PorterDuff.Mode.MULTIPLY);
+            contentView.setBackground(outerBackground);
+        }
+
+        var innerBackground = innerContainer.getBackground();
+        if (innerBackground != null) {
+            innerBackground = innerBackground.mutate();
+            innerBackground.setTint(menuBgColor);
+            innerBackground.setTintMode(PorterDuff.Mode.SRC_IN);
+            innerContainer.setBackground(innerBackground);
+        }
+    }
+
